# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/
CLAUDE.md

# Dotenv file
.env

# Scratch output from TenderInvariantsTest.afterInvariant() (Step 7b vacuity check)
test/invariant/.phase-reach-log.csv

# Local demo deployment state, written by DeployLocal.s.sol for the script/demo/*.s.sol
