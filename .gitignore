script/demo/.demo-state.json

# tools/ (Step 9a, Node + TypeScript): dependencies, compiled output, and generated
# receipts/document-encryption artifacts. `out/` above already covers tools/out/, since a
# pattern with no leading slash matches at any depth -- listed here anyway for clarity.
# tools/fixtures/commitment-vector.json is NOT ignored: it's the committed cross-language
# test vector test/CommitmentVector.t.sol depends on.
node_modules/
tools/dist/
tools/out/

